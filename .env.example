# Copy to .env.local for development.

# Backend origin. Local Spring Boot by default; set the Render URL for a deployed build.
VITE_API_BASE_URL=http://localhost:8080

# The *web* OAuth client from the Firebase project — the same one the Android app already passes as
# serverClientId. Using the same client is what lets /auth/google accept a browser-minted token with no
# backend change at all, since the server validates on audience alone.
#
# One external step is still required: add this panel's origin (http://localhost:5173 for dev, and the
# deployed URL for production) to that client's "Authorized JavaScript origins" in the Google Cloud
# console. Without it the sign-in button loads but the popup fails.
VITE_GOOGLE_CLIENT_ID=348288029176-tqsrb8v3rn2pghkhc19rfva89q7q9vis.apps.googleusercontent.com
